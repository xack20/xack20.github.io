{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/work/",
        "http://localhost/work/agentic-cms-assistant/",
        "http://localhost/work/mcp-tool-servers/",
        "http://localhost/work/agent-evals-guardrails/",
        "http://localhost/work/kon-ai-nagad/",
        "http://localhost/work/self-hosted-llms-rag/",
        "http://localhost/work/tag-explorer/",
        "http://localhost/work/card-reporting-data/",
        "http://localhost/work/ncp-fabric/",
        "http://localhost/work/nid-kyc/",
        "http://localhost/work/hisaab/",
        "http://localhost/work/whichllm-scraper-fix/",
        "http://localhost/projects/",
        "http://localhost/projects/running-the-agent-stack/",
        "http://localhost/projects/kona-identity-provider/",
        "http://localhost/projects/lmcanvas/",
        "http://localhost/projects/claude-code-tooling/",
        "http://localhost/projects/adda/",
        "http://localhost/experience/",
        "http://localhost/lab/",
        "http://localhost/writing/",
        "http://localhost/about/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}