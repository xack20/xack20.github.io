---
const ANSWER = 'The customer has 3 active cards, a daily limit of 50,000 BDT and 12 declined payments this week.';
const TOOLS = [
  { value: '3', label: 'Card lookup returned: 3 active cards' },
  { value: '50000', label: 'Limit lookup returned: daily limit 50,000 BDT' },
];
---
<div class="demo" data-lookup>
  <p class="q"><span class="badge">Operator asks</span> How many active cards does this customer have, and what is their daily limit?</p>
  <fieldset>
    <legend>Tool calls the agent made (untick one to see what changes)</legend>
    {TOOLS.map((t) => (
      <label><input type="checkbox" data-tool={t.value} checked disabled /> {t.label}</label>
    ))}
  </fieldset>
  <p class="badge">Model answers</p>
  <p class="answer" data-answer>{ANSWER}</p>
  <p class="verdict" data-verdict aria-live="polite"></p>
  <p class="nojs" data-nojs>
    This demo needs JavaScript. It highlights every number in the answer that no tool call returned. Here, "12 declined payments"
    has nothing behind it, so the check flags it.
  </p>
</div>

<script>
  import '../scripts/lab-lookup';
</script>

<style>
  .demo {
    margin-top: 24px; padding: clamp(18px, 4vw, 30px); border-radius: 18px; border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01) 40%, rgb(255 255 255 / 0.03)), rgb(13 13 17 / 0.72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    display: grid; gap: 14px;
  }
  .badge { font: 500 11px var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-right: 8px; }
  .q { color: var(--ink-2); }
  fieldset { border: 1px solid var(--line); border-radius: 12px; padding: 8px 16px 10px; display: grid; gap: 2px; }
  legend { padding: 0 6px; color: var(--muted); font-size: 14px; }
  label { display: flex; gap: 10px; align-items: center; min-height: 44px; color: var(--ink-2); font: 400 15px var(--font-body); cursor: pointer; }
  input { width: 18px; height: 18px; accent-color: var(--accent); }
  input:disabled { cursor: not-allowed; }
  .answer { font: 400 17px/1.7 var(--font-body); padding: 16px; border-radius: 12px; background: rgb(0 0 0 / 0.4); border: 1px solid var(--line); }
  .answer :global(mark) { color: inherit; padding: 1px 4px; border-radius: 6px; }
  /* Backed numbers sit in the accent; an unbacked one is the rejected colour, named again in the verdict text. */
  .answer :global(mark.backed) { background: rgb(127 212 255 / 0.14); outline: 1px solid rgb(127 212 255 / 0.5); }
  .answer :global(mark.unbacked) { background: rgb(255 154 143 / 0.16); outline: 1px solid var(--bad); text-decoration: underline wavy var(--bad); text-underline-offset: 4px; }
  .verdict { color: var(--ink-2); font-size: 15px; }
  .nojs { color: var(--muted); font-size: 15px; }
</style>
