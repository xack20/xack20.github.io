---
import type { WritingItem } from '../data/writing';

interface Props {
  items: readonly WritingItem[];
  columns?: 2 | 3;
  short?: boolean;
}

const { items, columns = 3, short = false } = Astro.props;
---
<ul class:list={['grid', `cols-${columns}`]}>
  {items.map((item) => (
    <li class="reveal">
      <a class="mini" href={item.href}>
        <span class="meta">{item.meta}</span>
        <h3>{item.title}</h3>
        <p>{short ? item.short : item.body}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  .grid { display: grid; gap: 16px; margin-top: 32px; list-style: none; }
  .cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mini {
    display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 22px; border-radius: 18px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.015) 40%, rgb(255 255 255 / 0.035)), rgb(13 13 17 / 0.72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    transition: transform 0.45s var(--ease), border-color 0.3s, box-shadow 0.3s;
  }
  .mini:hover, .mini:focus-visible {
    transform: translateY(-3px); border-color: rgb(255 255 255 / 0.24);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18), 0 30px 60px -30px rgb(0 0 0 / 0.9), 0 0 80px -36px var(--accent-2);
  }
  .mini:focus-visible { border-radius: 18px; }
  .meta { font: 500 11px/1 var(--font-mono); color: var(--muted); letter-spacing: 0.06em; }
  h3 { font: 560 19px/1.25 var(--font-display); letter-spacing: -0.01em; text-wrap: balance; }
  p { color: var(--ink-2); font-size: 14.5px; line-height: 1.55; }
  @media (max-width: 900px) {
    .cols-3, .cols-2 { grid-template-columns: minmax(0, 1fr); }
  }
</style>
