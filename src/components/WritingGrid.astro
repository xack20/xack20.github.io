---
import type { WritingItem } from '../data/writing';

interface Props {
  items: readonly WritingItem[];
  columns?: 2 | 3;
  short?: boolean;
}

const { items, columns = 3, short = false } = Astro.props;
---
<ul class:list={['grid', `cols-${columns}`]}>
  {items.map((item) => (
    <li class="reveal">
      <a class="mini" href={item.href}>
        <span class="meta">{item.meta}</span>
        <h3>{item.title}</h3>
        <p>{short ? item.short : item.body}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  .grid { display: grid; gap: 18px; margin-top: 40px; list-style: none; }
  .cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mini {
    display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 24px; border-radius: 18px;
    border: 1px solid var(--line); background: var(--card); transition: transform 0.4s var(--ease), border-color 0.4s;
  }
  .mini:hover, .mini:focus-visible { border-color: rgba(232, 196, 120, 0.5); transform: translateY(-4px); }
  .meta { font: 500 12px var(--font-mono); color: var(--gold); text-transform: uppercase; letter-spacing: 0.5px; }
  h3 { font: 600 19px/1.3 var(--font-display); }
  p { color: var(--muted); font-size: 15px; line-height: 1.55; }
  @media (max-width: 900px) {
    .cols-3, .cols-2 { grid-template-columns: minmax(0, 1fr); }
  }
</style>
