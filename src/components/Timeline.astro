---
import type { PathItem } from '../data/path';

interface Props {
  items: readonly PathItem[];
}

const { items } = Astro.props;
---
<ol class="tl">
  {items.map((item) => (
    <li class="ti reveal">
      <p class="when">{item.when}</p>
      <h3>{item.title}</h3>
      <p class="body">{item.body}</p>
    </li>
  ))}
</ol>

<style>
  .tl { position: relative; margin-top: 36px; padding-left: 34px; list-style: none; }
  .tl::before {
    content: ''; position: absolute; left: 8px; top: 6px; bottom: 6px; width: 1px;
    background: linear-gradient(var(--accent), rgb(127 212 255 / 0.05));
  }
  .ti { position: relative; padding-bottom: 36px; }
  .ti::before {
    content: ''; position: absolute; left: -31px; top: 6px; width: 11px; height: 11px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--accent); box-shadow: 0 0 12px rgb(127 212 255 / 0.55);
  }
  .when { font: 500 12px/1 var(--font-mono); letter-spacing: 0.06em; color: var(--muted); }
  h3 { font: 560 20px/1.3 var(--font-display); letter-spacing: -0.01em; margin: 6px 0; }
  .body { color: var(--ink-2); max-width: 720px; }
</style>
