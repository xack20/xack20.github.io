---
import type { PathItem } from '../data/path';

interface Props {
  items: readonly PathItem[];
}

const { items } = Astro.props;
---
<ol class="tl">
  {items.map((item) => (
    <li class="ti reveal">
      <p class="when">{item.when}</p>
      <h3>{item.title}</h3>
      <p class="body">{item.body}</p>
    </li>
  ))}
</ol>

<style>
  .tl { position: relative; margin-top: 44px; padding-left: 34px; list-style: none; }
  .tl::before {
    content: ''; position: absolute; left: 8px; top: 6px; bottom: 6px; width: 1px;
    background: linear-gradient(var(--gold), rgba(232, 196, 120, 0.05));
  }
  .ti { position: relative; padding-bottom: 38px; }
  .ti::before {
    content: ''; position: absolute; left: -31px; top: 6px; width: 11px; height: 11px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--gold); box-shadow: 0 0 12px rgba(232, 196, 120, 0.6);
  }
  .when { font: 500 13px var(--font-mono); color: var(--gold); }
  h3 { font: 600 21px var(--font-display); margin: 6px 0; }
  .body { color: var(--muted); max-width: 760px; }
</style>
