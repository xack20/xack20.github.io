---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Accepted for older call sites; every card is now the same plate. */
  big?: boolean;
}

const { entry } = Astro.props;
const { card, summary, meta } = entry.data;
---
<a class="wcard reveal" href={`/work/${entry.id}/`} data-glow>
  <span class="glow" aria-hidden="true"></span>
  <span class="meta">{meta}</span>
  <h3>{card}</h3>
  <p>{summary}</p>
  <span class="go" aria-hidden="true">Read the case study →</span>
</a>

<script>
  import '../scripts/glow';
</script>

<style>
  /* Blueprint glass: a thin white rim, a top highlight, a very dark translucent fill, frost at rest. */
  .wcard {
    position: relative; display: flex; flex-direction: column; gap: 10px; min-height: 250px; padding: 24px 26px 20px; border-radius: 18px;
    overflow: hidden; border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.015) 40%, rgb(255 255 255 / 0.035)), rgb(13 13 17 / 0.72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    transition: transform 0.45s var(--ease), border-color 0.3s, box-shadow 0.3s;
  }
  .wcard:hover, .wcard:focus-visible {
    transform: translateY(-3px); border-color: rgb(255 255 255 / 0.24);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18), 0 30px 60px -30px rgb(0 0 0 / 0.9), 0 0 80px -36px var(--accent-2);
  }
  .wcard:focus-visible { border-radius: 18px; }
  .glow {
    position: absolute; left: 0; top: 0; width: 420px; height: 420px; margin: -210px 0 0 -210px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgb(76 157 255 / 0.14), transparent 60%);
    transform: translate(var(--mx, 50%), var(--my, 50%)); opacity: 0; transition: opacity 0.3s;
  }
  .wcard:hover .glow { opacity: 1; }
  .meta { font: 500 11px/1 var(--font-mono); color: var(--muted); letter-spacing: 0.06em; }
  h3 { font: 560 clamp(20px, 2vw, 24px)/1.22 var(--font-display); letter-spacing: -0.015em; text-wrap: balance; }
  p { color: var(--ink-2); font-size: 15px; line-height: 1.55; max-width: 520px; }
  .go { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); font: 500 12px/1.3 var(--font-mono); color: var(--accent); }
</style>
