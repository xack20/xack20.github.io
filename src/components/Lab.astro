---
const STEPS = [
  { action: 'propose', text: '1 · Agent proposes: raise a card limit', variant: 'lever' },
  { action: 'approve', text: '2 · A person approves', variant: 'lever' },
  { action: 'commit', text: '3 · Commit the change', variant: 'lever' },
  { action: 'replay', text: 'Try: commit again (replay)', variant: 'lever try' },
  { action: 'tamper', text: 'Try: change the limit after approval', variant: 'lever try' },
] as const;
---
<div class="lab reveal" data-lab>
  <div class="steps" role="group" aria-label="Approval flow steps">
    {STEPS.map((s) => (
      <button type="button" class={s.variant} data-action={s.action} disabled>
        <span class="lamp" aria-hidden="true"></span>{s.text}
      </button>
    ))}
    <button type="button" class="reset" data-action="reset" disabled>Reset</button>
  </div>
  <div class="log" data-log role="log" aria-label="What the ledger did" tabindex="0">
    <p class="tone-info">// click the steps in any order</p>
    <p class="tone-info">// try committing before approving</p>
  </div>
  <p class="nojs" data-nojs>
    This demo needs JavaScript. In short: the agent can only propose a change. A person approves it and gets a
    single-use token bound to a hash of that change. Committing without the token is blocked, a second commit is
    rejected, and editing the change after approval breaks the hash.
  </p>
</div>

<script>
  import '../scripts/lab';
</script>

<style>
  .lab {
    margin-top: 32px; padding: clamp(18px, 4vw, 30px); border-radius: 18px; border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01) 40%, rgb(255 255 255 / 0.03)), rgb(13 13 17 / 0.72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 28px; align-items: start;
  }
  .steps { display: flex; flex-direction: column; gap: 10px; }
  .lever {
    display: flex; align-items: center; gap: 14px; width: 100%; min-height: 48px; text-align: left; padding: 12px 16px; border-radius: 12px;
    border: 1px solid rgb(255 255 255 / 0.12); background: rgb(255 255 255 / 0.04); color: var(--ink); cursor: pointer;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    font: 500 15px var(--font-display); transition: border-color 0.3s, background-color 0.3s, transform 0.3s var(--ease);
  }
  .lever:hover:not(:disabled) { border-color: rgb(255 255 255 / 0.28); background: rgb(255 255 255 / 0.07); }
  .lever:active:not(:disabled) { transform: scale(0.98); }
  .lever:disabled { cursor: not-allowed; color: var(--muted); border-style: dashed; background: transparent; }
  .lever.try { border-style: dashed; }
  .lamp { width: 10px; height: 10px; border-radius: 50%; background: rgb(255 255 255 / 0.14); flex: none; transition: background 0.4s, box-shadow 0.4s; }
  /* One hue: a draft is blue, an approval is near-white, a rejection is the one colour outside the family. */
  .lever.on .lamp { background: var(--accent-2); box-shadow: 0 0 12px var(--accent-2); }
  .lever.ok .lamp { background: var(--accent-hi); box-shadow: 0 0 14px var(--accent); }
  .lever.bad .lamp { background: var(--bad); box-shadow: 0 0 14px var(--bad); }
  .reset {
    align-self: flex-start; min-height: 44px; background: none; border: none; color: var(--muted); cursor: pointer; padding: 10px 2px;
    font: 500 14px var(--font-display); text-decoration: underline; text-underline-offset: 4px;
  }
  .reset:hover:not(:disabled) { color: var(--ink); }
  .reset:disabled { cursor: not-allowed; }
  .log {
    font: 400 13.5px/1.7 var(--font-mono); color: var(--muted); background: rgb(0 0 0 / 0.4); border: 1px solid var(--line);
    border-radius: 12px; padding: 18px; min-height: 240px; max-height: 360px; overflow-y: auto; overflow-wrap: anywhere;
  }
  .log :global(p + p) { margin-top: 6px; }
  .log :global(.tone-ok) { color: var(--ok); }
  .log :global(.tone-bad) { color: var(--bad); }
  .nojs { grid-column: 1 / -1; color: var(--muted); font-size: 15px; }
  @media (max-width: 900px) {
    .lab { grid-template-columns: minmax(0, 1fr); }
  }
</style>
