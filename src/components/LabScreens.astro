---
const EXAMPLES = ['taka pathabo kivabe', 'pin vule gechi', 'send me the OTP', 'মোবাইল রিচার্জ করব', 'recharj', 'confirm with your pin'];
---
<div class="demo" data-screens>
  <form class="ask" data-form>
    <label for="screens-q">Ask the wallet assistant where to go</label>
    <div class="row">
      <input id="screens-q" type="text" autocomplete="off" placeholder="e.g. taka pathabo kivabe" disabled />
      <button type="submit" class="go" disabled>Find</button>
    </div>
  </form>
  <p class="examples">
    Try:
    {EXAMPLES.map((e) => <button type="button" class="chip" data-example={e} disabled>{e}</button>)}
  </p>
  <div class="result" data-result aria-live="polite"></div>
  <p class="nojs" data-nojs>
    This demo needs JavaScript. It matches questions in English, Bangla or Banglish to screens of an invented wallet, refuses to
    send anyone who forgot their PIN to Change PIN, and answers requests for a PIN or OTP with safety advice only.
  </p>
</div>

<script>
  import '../scripts/lab-screens';
</script>

<style>
  .demo {
    margin-top: 24px; padding: clamp(18px, 4vw, 30px); border-radius: 18px; border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01) 40%, rgb(255 255 255 / 0.03)), rgb(13 13 17 / 0.72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
  }
  label { font: 500 14px var(--font-display); color: var(--ink-2); }
  .row { display: flex; gap: 10px; margin-top: 8px; }
  input {
    flex: 1; min-width: 0; min-height: 44px; padding: 10px 14px; border-radius: 12px; border: 1px solid rgb(255 255 255 / 0.16); background: rgb(0 0 0 / 0.4);
    color: var(--ink); font: 400 16px var(--font-body); transition: border-color 0.2s;
  }
  input::placeholder { color: var(--muted); }
  input:hover:not(:disabled), input:focus { border-color: rgb(255 255 255 / 0.3); }
  input:disabled { color: var(--muted); border-style: dashed; cursor: not-allowed; }
  .go {
    min-height: 44px; padding: 10px 20px; border-radius: 12px; border: none; background: var(--ink); color: var(--bg); font: 550 15px var(--font-display); cursor: pointer;
    box-shadow: 0 0 30px -10px rgb(127 212 255 / 0.5); transition: background-color 0.2s;
  }
  .go:hover:not(:disabled) { background: #fff; }
  .go:disabled, .chip:disabled { cursor: not-allowed; color: var(--muted); background: transparent; border: 1px dashed rgb(255 255 255 / 0.16); box-shadow: none; }
  .examples { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; color: var(--muted); font-size: 14px; }
  .chip {
    min-height: 40px; padding: 8px 14px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.12); background: rgb(255 255 255 / 0.04);
    color: var(--ink-2); font: 500 13px var(--font-mono); cursor: pointer; transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }
  .chip:hover:not(:disabled) { color: var(--ink); border-color: rgb(255 255 255 / 0.28); background: rgb(255 255 255 / 0.07); }
  .chip:focus-visible, .go:focus-visible, .result :global(.screen-card:focus-visible) { border-radius: 999px; }
  .go:focus-visible { border-radius: 12px; }
  .result { margin-top: 18px; min-height: 64px; }
  .result :global(.card) { padding: 18px; border-radius: 12px; border: 1px solid rgb(255 255 255 / 0.12); background: rgb(0 0 0 / 0.4); color: var(--ink-2); }
  .result :global(.badge) { font: 500 11px var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); }
  .result :global(.card h3) { font: 560 20px var(--font-display); margin: 6px 0; color: var(--ink); }
  .result :global(.card ol) { padding-left: 20px; color: var(--ink-2); }
  .result :global(.screen-card) {
    margin-top: 12px; min-height: 44px; padding: 10px 18px; border-radius: 999px; border: 1px solid rgb(127 212 255 / 0.55); background: rgb(127 212 255 / 0.1);
    color: var(--ink); font: 560 14px var(--font-display); cursor: pointer; transition: background-color 0.2s;
  }
  .result :global(.screen-card:hover) { background: rgb(127 212 255 / 0.18); }
  /* A safety rule: the one colour outside the family, with its "Safety rule" badge saying the same. */
  .result :global(.warn) { border-color: var(--bad); }
  .result :global(.warn .badge) { color: var(--bad); }
  .result :global(.note) { margin-top: 8px; color: var(--muted); font-size: 14px; }
  .nojs { margin-top: 12px; color: var(--muted); font-size: 15px; }
</style>
