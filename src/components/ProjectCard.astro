---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, summary, meta, page, links, stack } = entry.data;
const href = page ? `/projects/${entry.id}/` : links[0]?.href;
---
{href ? (
  <a class="pcard reveal" href={href}>
    <span class="meta">{meta}</span>
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="stack">{stack.join(' · ')}</span>
    <span class="go" aria-hidden="true">{page ? 'Read more →' : 'View on GitHub →'}</span>
  </a>
) : (
  <div class="pcard reveal">
    <span class="meta">{meta}</span>
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="stack">{stack.join(' · ')}</span>
  </div>
)}

<style>
  .pcard {
    display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 24px; border-radius: 18px;
    border: 1px solid var(--line); background: var(--card); transition: transform 0.4s var(--ease), border-color 0.4s;
  }
  a.pcard:hover, a.pcard:focus-visible { border-color: rgba(232, 196, 120, 0.5); transform: translateY(-4px); }
  .meta { font: 500 12px var(--font-mono); color: var(--gold); text-transform: uppercase; letter-spacing: 0.5px; }
  h3 { font: 600 20px/1.3 var(--font-display); }
  p { color: var(--muted); font-size: 15px; line-height: 1.55; }
  .stack { font: 500 12px var(--font-mono); color: var(--ink-2); }
  .go { margin-top: auto; font: 600 14px var(--font-display); color: var(--gold); }
</style>
