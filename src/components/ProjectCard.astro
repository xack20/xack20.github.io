---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, summary, meta, page, links, stack } = entry.data;
const href = page ? `/projects/${entry.id}/` : links[0]?.href;
---
{href ? (
  <a class="pcard reveal" href={href}>
    <span class="meta">{meta}</span>
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="stack">{stack.join(' · ')}</span>
    <span class="go" aria-hidden="true">{page ? 'Read more →' : 'View on GitHub →'}</span>
  </a>
) : (
  <div class="pcard reveal">
    <span class="meta">{meta}</span>
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="stack">{stack.join(' · ')}</span>
  </div>
)}

<style>
  /* The same glass as WorkCard, one size down. */
  .pcard {
    display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 22px 22px 18px; border-radius: 18px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.015) 40%, rgb(255 255 255 / 0.035)), rgb(13 13 17 / 0.72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
    transition: transform 0.45s var(--ease), border-color 0.3s, box-shadow 0.3s;
  }
  a.pcard:hover, a.pcard:focus-visible {
    transform: translateY(-3px); border-color: rgb(255 255 255 / 0.24);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18), 0 30px 60px -30px rgb(0 0 0 / 0.9), 0 0 80px -36px var(--accent-2);
  }
  a.pcard:focus-visible { border-radius: 18px; }
  .meta { font: 500 11px/1 var(--font-mono); color: var(--muted); letter-spacing: 0.06em; }
  h3 { font: 560 19px/1.25 var(--font-display); letter-spacing: -0.01em; text-wrap: balance; }
  p { color: var(--ink-2); font-size: 14.5px; line-height: 1.55; }
  .stack { font: 400 11px/1.5 var(--font-mono); color: var(--muted); }
  .go { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--line); font: 500 12px/1.3 var(--font-mono); color: var(--accent); }
</style>
