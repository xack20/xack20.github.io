---
import { getCollection } from 'astro:content';
import WorkCard from '../../components/WorkCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const GROUPS = [
  { key: 'kona', title: 'At KONA' },
  { key: 'personal', title: 'Personal and open source' },
] as const;

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const groups = GROUPS.map((g) => ({ ...g, items: work.filter((entry) => entry.data.group === g.key) }));
---
<BaseLayout breadcrumbs={[{ name: 'Work', path: '/work/' }]} title="Work" description="Eleven case studies: AI agents for banks and a mobile wallet, MCP tool servers, evals, self-hosted LLMs, fund tracing, reporting and a Fabric commerce platform.">
  <header class="page-head">
    <h1 class="page-title">Work</h1>
    <p class="intro">Eleven projects, most of them from KONA Software Lab.</p>
  </header>
  {groups.map((g) => (
    <section class="section section-tight" aria-labelledby={`${g.key}-h`}>
      <h2 class="sub-h" id={`${g.key}-h`}>{g.title}</h2>
      <div class="work-grid">{g.items.map((entry) => <WorkCard entry={entry} />)}</div>
    </section>
  ))}
</BaseLayout>

<style>
  .work-grid { margin-top: 24px; gap: 16px; }
</style>
