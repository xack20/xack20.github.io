---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That address does not exist. The home page has everything." noindex>
  <section class="page-head lost">
    <p class="label">404</p>
    <h1 class="page-title">Page not found</h1>
    <p class="intro">That address does not exist. The home page has everything.</p>
    <div class="ctas">
      <a class="btn btn-primary" href="/">Back to the start</a>
      <a class="btn btn-ghost" href="/work/">See the work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost { min-height: 70svh; padding-bottom: 80px; }
</style>
