---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleNode, personNode } from '../../lib/seo/schema';

export async function getStaticPaths() {
  const pages = (await getCollection('projects')).filter((p) => p.data.page).sort((a, b) => a.data.order - b.data.order);
  return pages.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: pages[(i + 1) % pages.length] } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const facts = [
  { term: 'Where', value: data.org },
  { term: 'When', value: data.years },
  ...(data.status ? [{ term: 'Status', value: data.status }] : []),
  { term: 'My part', value: data.role },
];
---
<BaseLayout
  title={data.title}
  description={data.summary}
  type="article"
  schema={[articleNode({ title: data.title, description: data.summary, path: `/projects/${entry.id}/`, published: data.published }), personNode]}
  breadcrumbs={[{ name: 'Projects', path: '/projects/' }, { name: data.title, path: `/projects/${entry.id}/` }]}
>
  <article>
    <header class="page-head">
      <p class="label"><a href="/projects/">Projects</a> · {data.meta}</p>
      <h1 class="page-title">{data.title}</h1>
      <p class="outcome">{data.summary}</p>
      <dl class="facts">{facts.map((f) => <div><dt>{f.term}</dt><dd>{f.value}</dd></div>)}</dl>
    </header>
    <div class="body">
      <div class="prose"><Content /></div>
      <section class="extra" aria-labelledby="stack-h">
        <h2 id="stack-h">Stack</h2>
        <ul class="tags">{data.stack.map((s) => <li>{s}</li>)}</ul>
      </section>
      {data.links.length > 0 && (
        <section class="extra" aria-labelledby="links-h">
          <h2 id="links-h">Links</h2>
          <ul class="plain-list">{data.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </section>
      )}
      <nav class="next" aria-label="Next project">
        <span class="label">Next</span>
        <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .outcome { font-size: clamp(18px, 2vw, 21px); color: var(--ink-2); max-width: 760px; }
  .facts {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 32px; padding: 24px;
    border: 1px solid var(--line); border-radius: 18px; background: var(--card);
  }
  dt { font: 500 11px var(--font-mono); letter-spacing: 1.5px; text-transform: uppercase; color: var(--gold); }
  dd { color: var(--ink-2); font-size: 15px; margin-top: 4px; }
  .body { max-width: var(--max); margin: 0 auto; padding: 16px var(--gutter) 80px; }
  .extra { margin-top: 48px; }
  .extra h2 { font: 600 clamp(22px, 2.6vw, 28px)/1.2 var(--font-display); margin-bottom: 14px; }
  .extra a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .next { margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
  .next a { font: 600 clamp(20px, 2.4vw, 26px) var(--font-display); }
  .next a:hover { color: var(--gold); }
  @media (max-width: 900px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .facts { grid-template-columns: minmax(0, 1fr); } }
</style>
