---
import { getCollection } from 'astro:content';
import Contact from '../components/Contact.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import WritingGrid from '../components/WritingGrid.astro';
import { PATH } from '../data/path';
import { WRITING } from '../data/writing';
import Home from '../islands/home/Home';
import BaseLayout from '../layouts/BaseLayout.astro';
import { toPlates } from '../lib/scene/plates';
import { personNode, websiteNode } from '../lib/seo/schema';
import '../styles/tailwind.css';
import '../styles/scene/tokens.css';
import '../styles/scene/stage.css';
import '../styles/scene/copy.css';
import '../styles/scene/plate.css';
import '../styles/scene/work-list.css';
import '../styles/scene/signal.css';

const plates = toPlates(await getCollection('work'));
---
<BaseLayout schema={[personNode, websiteNode]}>
  <Home plates={plates} client:load />

  <section class="section" id="path" aria-labelledby="path-h">
    <SectionHeader label="2017 to now" headingId="path-h">Experience</SectionHeader>
    <Timeline items={PATH.filter((p) => p.home)} />
    <a class="more reveal" href="/experience/">Full experience →</a>
    <a class="more more-2 reveal" href="/about/">About me →</a>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-h">
    <SectionHeader label="Articles and merged fixes" headingId="writing-h">Open source and writing</SectionHeader>
    <WritingGrid items={WRITING.filter((w) => w.home)} short />
    <a class="more reveal" href="/writing/">All writing and open source →</a>
  </section>

  <Contact />
</BaseLayout>
