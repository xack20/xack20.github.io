---
import { CONTESTS, EDUCATION, ROLES } from '../data/experience';
import { LINKS, SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { personNode, profileNode } from '../lib/seo/schema';
---
<BaseLayout schema={[profileNode('/experience/'), personNode]} breadcrumbs={[{ name: 'Experience', path: '/experience/' }]} title="Experience" description="Every role, with what I built in each: KONA Software Lab, BJIT and earlier web work, plus education and competitive programming.">
  <header class="page-head">
    <h1 class="page-title">Experience</h1>
    <p class="intro">Every role and what I did in it. Most lines link to a case study or a project page.</p>
    <div class="ctas">
      <a class="btn btn-primary" href={SITE.cvPath} download={SITE.cvFileName}>Download CV</a>
      <a class="btn btn-ghost" href={LINKS.linkedin}>LinkedIn</a>
    </div>
  </header>

  <section class="section section-tight roles" aria-label="Roles">
    {ROLES.map((role) => (
      <article class="role reveal" id={role.id}>
        <div class="when">
          <span>{role.start} – {role.end}</span>
        </div>
        <div class="what">
          <h2>{role.title}</h2>
          <p class="org">{role.org} · {role.location}</p>
          {role.intro && <p class="role-intro">{role.intro}</p>}
          <ul>
            {role.bullets.map((b) => (
              <li>
                {b.text}
                {b.href && <> <a class="more-link" href={b.href}>Read more →</a></>}
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </section>

  <section class="section section-tight" aria-labelledby="edu-h">
    <h2 class="sub-h" id="edu-h">Education</h2>
    <article class="role edu">
      <div class="when"><span>{EDUCATION.years}</span></div>
      <div class="what">
        <h3>{EDUCATION.degree}</h3>
        <p class="org">{EDUCATION.school} · {EDUCATION.grade}</p>
        <p class="role-intro">{EDUCATION.thesis}</p>
      </div>
    </article>
  </section>

  <section class="section section-tight" aria-labelledby="cp-h">
    <h2 class="sub-h" id="cp-h">Competitive programming and activities</h2>
    <ul class="plain-list">{CONTESTS.map((c) => <li>{c}</li>)}</ul>
  </section>
</BaseLayout>

<style>
  .roles { display: grid; gap: 16px; }
  /* Each role is a glass panel: dates in the left column, the role in the right. */
  .role {
    display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 24px; padding: clamp(20px, 3vw, 30px); border-radius: 18px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01) 40%, rgb(255 255 255 / 0.03)), rgb(13 13 17 / 0.72);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(1.4);
  }
  .when span { font: 500 12px/1.6 var(--font-mono); letter-spacing: 0.06em; color: var(--muted); }
  h2, h3 { font: 560 clamp(21px, 2.4vw, 26px)/1.2 var(--font-display); letter-spacing: -0.015em; }
  .org { color: var(--ink-2); margin-top: 4px; }
  .role-intro { color: var(--ink-2); margin-top: 12px; max-width: 720px; }
  ul { margin-top: 16px; padding-left: 20px; display: grid; gap: 10px; color: var(--ink-2); max-width: 760px; }
  li::marker { color: var(--accent-2); }
  .more-link { color: var(--accent); white-space: nowrap; text-decoration: underline; text-underline-offset: 3px; }
  .more-link:hover { text-decoration-thickness: 2px; }
  .edu { margin-top: 20px; }
  @media (max-width: 760px) {
    .role { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }
</style>
