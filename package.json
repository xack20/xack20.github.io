{
  "name": "xack20-portfolio",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "guards": "node scripts/guards/run.mjs --dist dist --cv public/cv.pdf --repo && node scripts/check-links.mjs dist",
    "cv": "node scripts/make-public-cv.mjs",
    "og": "node scripts/make-og.mjs",
    "verify": "npm run check && npm run test:unit && npm run build && npm run guards && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "5.9.3",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.3"
  }
